<?xml version='1.0' encoding='UTF-8'?>
<model name="my_model" xmlns="http://www.cellml.org/cellml/2.0#" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
    <units name="per_second">
        <unit units="second" exponent="-1"/>
    </units>
    <component name="my_component">
        <variable name="t" units="second"/>
        <variable name="x" units="dimensionless" initial_value="1"/>
        <variable name="y" units="dimensionless" initial_value="2"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x</ci>
                </apply>
                <apply>
                    <plus/>
                    <cn cellml:units="per_second">1</cn>
                    <apply>
                        <diff/>
                        <bvar>
                            <ci>t</ci>
                        </bvar>
                        <ci>y</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>y</ci>
                </apply>
                <apply>
                    <minus/>
                    <cn cellml:units="per_second">2</cn>
                    <apply>
                        <diff/>
                        <bvar>
                            <ci>t</ci>
                        </bvar>
                        <ci>x</ci>
                    </apply>
                </apply>
            </apply>
        </math>
    </component>
    <component name="my_algebraic_system">
        <variable initial_value="1" name="x" units="dimensionless"/>
        <variable initial_value="1" name="y" units="dimensionless"/>
        <variable initial_value="1" name="z" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <plus/>
                    <ci>x</ci>
                    <ci>y</ci>
                    <ci>z</ci>
                </apply>
                <cn cellml:units="dimensionless">2</cn>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">6</cn>
                        <ci>x</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">-4</cn>
                        <ci>y</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">5</cn>
                        <ci>z</ci>
                    </apply>
                </apply>
                <cn cellml:units="dimensionless">31</cn>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">5</cn>
                        <ci>x</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2</cn>
                        <ci>y</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2</cn>
                        <ci>z</ci>
                    </apply>
                </apply>
                <cn cellml:units="dimensionless">31</cn>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">-2</cn>
                        <ci>x</ci>
                    </apply>
                    <ci>y</ci>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">3</cn>
                        <ci>z</ci>
                    </apply>
                </apply>
                <cn cellml:units="dimensionless">-5</cn>
            </apply>
        </math>
    </component>
</model>
