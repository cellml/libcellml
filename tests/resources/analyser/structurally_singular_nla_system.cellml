<?xml version='1.0' encoding='UTF-8'?>
<model name="my_model" xmlns="http://www.cellml.org/cellml/2.0#" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
    <!-- Define an NLA system with as many NLA equations as unknown variables, but which NLA equations have the following
unknown variables: {a}, {a}, and {a, b, c}. So, 'a' is overconstrained (by sin(a) = x and cos(a) = x+1) while 'b'
and 'c' are underconstrained (by a*b+sin(c) = 2), i.e. the NLA system is structurally singular. -->
    <component name="main">
        <variable name="t" units="dimensionless"/>
        <variable initial_value="0" name="x" units="dimensionless"/>
        <variable initial_value="1" name="a" units="dimensionless"/>
        <variable initial_value="1" name="b" units="dimensionless"/>
        <variable initial_value="1" name="c" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x</ci>
                </apply>
                <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <sin/>
                    <ci>a</ci>
                </apply>
                <ci>x</ci>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <cos/>
                    <ci>a</ci>
                </apply>
                <apply>
                    <plus/>
                    <ci>x</ci>
                    <cn cellml:units="dimensionless">1</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <ci>a</ci>
                        <ci>b</ci>
                    </apply>
                    <apply>
                        <sin/>
                        <ci>c</ci>
                    </apply>
                </apply>
                <cn cellml:units="dimensionless">2</cn>
            </apply>
        </math>
    </component>
</model>
