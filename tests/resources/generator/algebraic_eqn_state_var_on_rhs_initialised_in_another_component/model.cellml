<?xml version='1.0' encoding='UTF-8'?>
<model name="my_model" xmlns="http://www.cellml.org/cellml/2.0#" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
    <!-- Algebraic equation with a function of a state variable on its RHS, where the state variable is initialised in
   a different component from the one where its ODE is, and where the algebraic equation comes before that ODE.
   xx = 2*x
   d(x)/d(t) = 1
   y = xx+1
   d(z)/d(t) = y-->
    <component name="environment">
        <variable interface="public" name="t" units="dimensionless"/>
    </component>
    <component name="my_algebraic_eqn">
        <variable interface="public" name="x" units="dimensionless"/>
        <variable interface="public" name="xx" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>xx</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">2</cn>
                    <ci>x</ci>
                </apply>
            </apply>
        </math>
    </component>
    <component name="my_ode">
        <variable interface="public" name="t" units="dimensionless"/>
        <variable interface="public" name="x" units="dimensionless"/>
        <variable interface="public" name="xx" units="dimensionless"/>
        <variable name="y" units="dimensionless"/>
        <variable initial_value="0" name="z" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x</ci>
                </apply>
                <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
                <eq/>
                <ci>y</ci>
                <apply>
                    <plus/>
                    <ci>xx</ci>
                    <cn cellml:units="dimensionless">1</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>z</ci>
                </apply>
                <ci>y</ci>
            </apply>
        </math>
    </component>
    <component name="my_parameters">
        <variable initial_value="1" interface="public" name="x" units="dimensionless"/>
    </component>
    <connection component_1="environment" component_2="my_ode">
        <map_variables variable_1="t" variable_2="t"/>
    </connection>
    <connection component_1="my_algebraic_eqn" component_2="my_ode">
        <map_variables variable_1="x" variable_2="x"/>
        <map_variables variable_1="xx" variable_2="xx"/>
    </connection>
    <connection component_1="my_ode" component_2="my_parameters">
        <map_variables variable_1="x" variable_2="x"/>
    </connection>
</model>
