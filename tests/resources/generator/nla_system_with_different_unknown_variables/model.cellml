<?xml version='1.0' encoding='UTF-8'?>
<model name="my_model" xmlns="http://www.cellml.org/cellml/2.0#" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
    <!-- Define an NLA system which NLA equations don't have the same unknown variables, i.e. {a} and {a, b}. That NLA
system consists of two NLA equations for two unknown variables, i.e. it is neither overconstrained nor underconstrained,
and its objective function must solve for both 'a' and 'b'. -->
    <component name="main">
        <variable name="t" units="dimensionless"/>
        <variable initial_value="0" name="x" units="dimensionless"/>
        <variable initial_value="1" name="a" units="dimensionless"/>
        <variable initial_value="1" name="b" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>x</ci>
                </apply>
                <cn cellml:units="dimensionless">1</cn>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <sin/>
                    <ci>a</ci>
                </apply>
                <ci>x</ci>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <times/>
                    <ci>a</ci>
                    <ci>b</ci>
                </apply>
                <apply>
                    <plus/>
                    <ci>x</ci>
                    <cn cellml:units="dimensionless">2</cn>
                </apply>
            </apply>
        </math>
    </component>
</model>
